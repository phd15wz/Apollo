__pycache__/
.pytest_cache/

# OKX bulk market data — several GB/month; never commit.
# Default cache is ~/.cache/apollo/okx (OKX_DATA_DIR). These entries catch
# accidental in-repo downloads.
.okx-data/
okx-data/
data/okx/
tools/okx/data/
tools/okx/cache/
*.okx.zip
*.zip.part
*.jsonl.gz

# Macro rates/DXY cache. Default is ~/.cache/apollo/macro (MACRO_DATA_DIR).
# These entries catch accidental in-repo downloads. No FRED key, Yahoo HTML, or bulk dump.
.macro-data/
macro-data/
data/macro/
tools/macro/data/
tools/macro/cache/

